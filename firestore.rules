rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // CRITICAL SECURITY HARDENING:
    // Direct client read/write access to Firestore is permanently disabled.
    // All queries, responses, reveals, profiles, and moderation reports MUST
    // route through the Spring Boot REST API which enforces:
    //   - PostgreSQL Row Level Security (RLS)
    //   - Cryptographic RS256 JWT validation
    //   - Server-side IDOR checks
    //   - Strict anonymity serialization
    //   - Transactional consent-gated identity reveals
    //   - Append-only immutable audit logging
    // =========================================================================

    // Deny all client access across all collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
