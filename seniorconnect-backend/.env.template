# SeniorConnect Backend Environment Template
# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/seniorconnect
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Redis Configuration
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# RSA Key Paths
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem

# Firebase Admin SDK Service Account Credentials Path
# Obtain from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json
